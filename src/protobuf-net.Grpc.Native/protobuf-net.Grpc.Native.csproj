<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>ProtoBuf.Grpc</RootNamespace>
    <Title>protobuf-net.Grpc.Native</Title>
    <Description>Code-first gRPC over the unmanaged Grpc.Core API</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Core" />
    <ProjectReference Include="..\protobuf-net.Grpc\protobuf-net.Grpc.csproj" />
  </ItemGroup>
  <ItemGroup Label="public API tracking">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <!-- one surface for every target framework: these projects have no per-TFM API differences -->
    <AdditionalFiles Include="PublicAPI/PublicAPI.*.txt" />
  </ItemGroup>
</Project>
