<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net472;netstandard2.1;netstandard2.0;net8.0;net10.0</TargetFrameworks>
        <RootNamespace>ProtoBuf.Grpc.Reflection</RootNamespace>
        <Title>protobuf-net.Grpc.Reflection</Title>
        <Description>Generates .proto schemas from code-first gRPC contracts, and implements the gRPC reflection service</Description>
    </PropertyGroup>

    <ItemGroup>
        <!-- note this uses v3 features that are not back-ported to v2 -->
        <PackageReference Include="protobuf-net.Reflection" />
        <PackageReference Include="protobuf-net" />
        <PackageReference Include="protobuf-net.Core" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\protobuf-net.Grpc\protobuf-net.Grpc.csproj" />
    </ItemGroup>

    <ItemGroup Label="public API tracking">
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
        <!-- one surface for every target framework: these projects have no per-TFM API differences -->
        <AdditionalFiles Include="PublicAPI/PublicAPI.*.txt" />
    </ItemGroup>
    <PropertyGroup>
        <!-- the grpc.reflection.v1alpha surface is generated from reflection.proto, and the generator
             emits oblivious reference types; RS0041 is about those, and nothing here can fix them -->
        <NoWarn>$(NoWarn);RS0041</NoWarn>
    </PropertyGroup>
</Project>